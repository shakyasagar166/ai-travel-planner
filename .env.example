# ==============================================================================
# AI TRAVEL PLANNER AGENT - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Meta
PROJECT_NAME="AI Travel Planner Agent"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security & JWT Authentication
# Generate in terminal using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_key_in_production_abcdef123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=travel_ai

# Groq LLM Provider
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Chroma Vector Database
CHROMA_PERSIST_DIRECTORY=./vectorstore

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
